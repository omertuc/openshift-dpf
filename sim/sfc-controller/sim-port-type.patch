+package controller
+
+import (
+	"context"
+	"testing"
+
+	"github.com/nvidia/doca-platform/pkg/ovsutils"
+
+	"go.uber.org/mock/gomock"
+)
+
+func TestAddPortInterfaceType(t *testing.T) {
+	for _, tc := range []struct {
+		env  string
+		want string
+	}{
+		{env: "", want: InterfaceTypeDPDK},
+		{env: "system", want: "system"},
+	} {
+		t.Setenv(PortInterfaceTypeEnv, tc.env)
+		ctrl := gomock.NewController(t)
+		ovsMock := ovsutils.NewMockAPI(ctrl)
+		ovsMock.EXPECT().AddPort(gomock.Any(), ovsutils.PortConfig{
+			BridgeName: SFCBridge, Name: "p0", InterfaceType: tc.want,
+		}).Return(nil)
+		ovsMock.EXPECT().SetIfaceExternalIDs(gomock.Any(), "p0", gomock.Any()).Return(nil)
+		ovsMock.EXPECT().SetPortExternalIDs(gomock.Any(), "p0", gomock.Any()).Return(nil)
+		if err := AddPort(context.Background(), ovsMock, "p0", nil, nil); err != nil {
+			t.Fatalf("%s=%q: %v", PortInterfaceTypeEnv, tc.env, err)
+		}
+	}
+}
diff --git a/internal/sfccontroller/controllers/serviceinterface_controller.go b/internal/sfccontroller/controllers/serviceinterface_controller.go
index e5fcb458..e749edd1 100644
--- a/internal/sfccontroller/controllers/serviceinterface_controller.go
+++ b/internal/sfccontroller/controllers/serviceinterface_controller.go
@@ -20,6 +20,7 @@ import (
 	"context"
 	"fmt"
 	"hash/fnv"
+	"os"
 	"strconv"
 	"strings"
 	"time"
@@ -52,6 +53,13 @@ const (
 	InterfaceTypeDPDK          = "dpdk"
 	InterfaceTypePatch         = "patch"
 
+	// PortInterfaceTypeEnv overrides the OVS interface type of the ports the
+	// SFC controller adds to br-sfc (physical, PF, VF and SF ports), which is
+	// InterfaceTypeDPDK by default. A simulated DPU without BlueField hardware
+	// runs OVS's kernel datapath, where its veths and NICs are "system" ports
+	// and a "dpdk" port never gets an ofport.
+	PortInterfaceTypeEnv = "DPF_SIM_PORT_TYPE"
+
 	// Patch port naming formats
 	peerPatchNameFormat   = "p_%s_to_%s"      // used when PeerPatchName is specified
 	patchPortHashedFormat = "p_%s_to_%s_%08x" // used for auto-generated names with hash
@@ -100,11 +108,20 @@ type ServiceInterfaceReconciler struct {
 // +kubebuilder:rbac:groups=svc.dpu.nvidia.com,resources=serviceinterfaces/finalizers,verbs=update
 // +kubebuilder:rbac:groups="",resources=nodes,verbs=get;list;watch
 
+// portInterfaceType is the OVS interface type of the ports AddPort adds:
+// InterfaceTypeDPDK unless PortInterfaceTypeEnv says otherwise.
+func portInterfaceType() string {
+	if interfaceType := os.Getenv(PortInterfaceTypeEnv); interfaceType != "" {
+		return interfaceType
+	}
+	return InterfaceTypeDPDK
+}
+
 func AddPort(ctx context.Context, ovs ovsutils.API, portName string, ifaceExternalIDs, portExternalIDs map[string]string) error {
 	if err := ovs.AddPort(ctx, ovsutils.PortConfig{
 		BridgeName:    SFCBridge,
 		Name:          portName,
-		InterfaceType: InterfaceTypeDPDK,
+		InterfaceType: portInterfaceType(),
 	}); err != nil {
 		return err
 	}
