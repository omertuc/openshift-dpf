+// Simulated scalable functions: see openshift-dpf sim/. A DPU without SF
+// hardware advertises device IDs with this prefix. Such a "SF" is an OVS
+// internal port moved into the container: in the container it is the SF
+// netdev, in OVS it is the SF representor. OVS-DOCA's netdev datapath takes
+// internal ports (but not veths), and keeps forwarding after the move.
+const simSFPrefix = "sim-sf-"
+
+func isSimSF(deviceID string) bool {
+	return strings.HasPrefix(deviceID, simSFPrefix)
+}
+
+// simSFPortName is the OVS port name of a simulated SF: deterministic, so
+// CmdDel finds it without a netns, and at most 15 characters.
+func simSFPortName(containerID, ifName string) string {
+	return fmt.Sprintf("ssf%x", sha256.Sum256([]byte(containerID+"/"+ifName)))[:15]
+}
+
+// moveSimSFToContainer moves the internal port's netdev into the container,
+// renames it to ifName and applies the MTU and requested MAC.
+func moveSimSFToContainer(contNetns ns.NetNS, portName, ifName, requestedMac string, mtu int) (*current.Interface, error) {
+	link, err := netlink.LinkByName(portName)
+	if err != nil {
+		return nil, err
+	}
+	if err := netlink.LinkSetNsFd(link, int(contNetns.Fd())); err != nil {
+		return nil, fmt.Errorf("move %s into container: %v", portName, err)
+	}
+	contIface := &current.Interface{Name: ifName, Sandbox: contNetns.Path()}
+	err = contNetns.Do(func(_ ns.NetNS) error {
+		link, err := netlink.LinkByName(portName)
+		if err != nil {
+			return err
+		}
+		if err := netlink.LinkSetName(link, ifName); err != nil {
+			return err
+		}
+		if mtu > 0 {
+			if err := netlink.LinkSetMTU(link, mtu); err != nil {
+				return err
+			}
+		}
+		if requestedMac != "" {
+			hwAddr, err := net.ParseMAC(requestedMac)
+			if err != nil {
+				return err
+			}
+			if err := assignMacToLink(link, hwAddr, ifName); err != nil {
+				return err
+			}
+		}
+		if err := setInterfaceUp(ifName); err != nil {
+			return err
+		}
+		contIface.Mac = getHardwareAddr(ifName)
+		return nil
+	})
+	return contIface, err
+}
